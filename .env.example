# --- Required ---------------------------------------------------------
GROQ_API_KEY=

# Random string used to sign login session cookies. Set this to something
# long and random in production - if left unset, a fixed dev value is
# used, which is fine for local testing only.
FLASK_SECRET_KEY=

# --- Optional overrides -------------------------------------------------
DB_PATH=app.db
KNOWLEDGE_FILE=data/knowledge.txt

GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3
GROQ_SEARCH_MODEL=groq/compound

# Speech input/output is limited to Indian languages plus English: Hindi,
# Bengali, Marathi, Telugu, Tamil, Gujarati, Kannada, Malayalam, and
# Punjabi. Urdu is intentionally NOT included. See ALLOWED_LANGS in
# modl.py to change this list.

# How answer_query() answers questions ("web" search vs local "document").
# Toggleable at runtime without a restart via the "Web search"/"Knowledge
# doc" button in the chat header, or GET/POST /api/settings/answer_mode.
ANSWER_MODE=web

# Optional shared secret checked against the ESP32 device's X-Api-Key
# header on /esp/* routes. Leave blank to disable.
ESP_API_KEY=

# --- Text-to-speech / speech-to-text priority: Bhashini -> espeak-ng -> Groq TTS ---
# Bhashini (below) has priority for BOTH speech recognition and
# text-to-speech. espeak-ng just needs to be installed on the server
# (sudo apt-get install espeak-ng / brew install espeak-ng) - no env vars
# needed, and is the TTS fallback if Bhashini isn't configured or fails.
# Groq TTS (uses GROQ_API_KEY above) is the last resort, and only works
# for English - Groq doesn't currently offer voices for the Indian
# languages this app supports.
# GROQ_TTS_MODEL=playai-tts
# GROQ_TTS_VOICE=Fritz-PlayAI

# --- Bhashini (ULCA) - HIGHEST PRIORITY for speech recognition and
# text-to-speech; also used for translation ahead of Groq. -----------------
# Get these by logging into https://bhashini.gov.in/ulca/profile
# ("My Profile" page):
#   - BHASHINI_USER_ID: shown on the My Profile page itself.
#   - BHASHINI_ULCA_API_KEY: the key from the "API Key" / "Generate"
#     section on the same page.
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
# Optional: override the default public MeitY pipeline id.
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
